[Unit]
Description=NCM TinyStories CUDA generation and evaluation
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/ncm/venv/bin/python

[Service]
Type=oneshot
User=ncm
Group=ncm
WorkingDirectory=/opt/ncm/repo
Environment=HOME=/opt/ncm
Environment=HF_HOME=/opt/ncm/cache
Environment=PYTHONUNBUFFERED=1
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/usr/local/bin/ncm-tinystories
TimeoutStartSec=infinity
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
