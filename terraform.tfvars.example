environment        = "ncm-tinystories"
domain_name        = "YOUR_OTC_DOMAIN"
public_key         = "ssh-ed25519 AAAA... your-key"
ssh_allowed_cidr   = "203.0.113.10/32" # Replace with your public IPv4 address.
availability_zone1 = "eu-de-01"       # Verify GPU capacity in your tenant/AZ.
flavor_id          = "p3.2xlarge.8"   # 1 x NVIDIA A100, 8 vCPU, 64 GiB RAM.
image_name         = "Standard_Ubuntu_22.04_latest"
root_volume_size   = 100
webui_allowed_cidr = "0.0.0.0/0" # Public HTTP WebUI on port 8080 (lab use).

# Credentials preferably via TF_VAR_access_key / TF_VAR_secret_key.
# access_key = "..."
# secret_key = "..."

auto_start      = true
eval_samples    = 16 # Per seed; five seeds => 80 stories.
eval_batch_size = 4
